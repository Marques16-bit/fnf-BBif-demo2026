<?xml version='1.0' encoding='utf-8'?>
<project>
	

	<app title="Baldi's Basics in Funkin'" file="BaldiFunkin" packageName="com.baldifunkinteam.baldifunkin" package="com.baldifunkinteam.baldifunkin" main="Main" version="0.0.1" company="BaldiFunkinTeam" />

	
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	
	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB" /> 

	
	
	<app preloader="flixel.system.FlxPreloader" />

	
	<set name="SWF_VERSION" value="11.8" />
	
	
	<setenv name="HAXEPATH" value="./" />
	

	<define name="MODS_ALLOWED" if="desktop" />
	<define name="HSCRIPT_ALLOWED" if="desktop" />
	<define name="LUA_ALLOWED" if="cpp" />
	<define name="VIDEOS_ALLOWED" if="cpp" />
	<define name="DISCORD_ALLOWED" if="cpp" />
    
	<define name="DEBUG_FEATURES" />

	

	
	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" />

	
	<window if="html5" resizable="true" />

	
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false" />

	
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false" />

	
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />

	

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />
    <set name="BUILD_DIR" value="${BUILD_DIR}-tracy" if="FEATURE_DEBUG_TRACY" />

	<classpath name="source" />

	

	<assets path="assets" />

	<assets path="art/alsoft.ini" rename="alsoft.ini" if="windows" />
	<assets path="art/alsoft.ini" rename="alsoft.conf" if="mac" />

	

	<lime version="8.1.3" />
	<haxelib name="openfl" />

	<haxelib name="flixel" />
	<haxelib name="flixel-ui" />
	<haxelib name="flixel-addons" />
	<haxelib name="tjson" />
	<haxelib name="hxIni" />
	<haxelib name="away3d" />

	<haxelib name="linc_luajit" if="LUA_ALLOWED" />
	<haxelib name="hxvlc" if="VIDEOS_ALLOWED" />
	<haxelib name="hxdiscord_rpc" if="DISCORD_ALLOWED" />
	<haxelib name="hscript-iris" if="HSCRIPT_ALLOWED" />
	<haxelib name="flixel-animate" />

	
	<haxedef name="DISCORD_DISABLE_IO_THREAD" if="hxdiscord_rpc" />
	<haxedef name="NO_PRECOMPILED_HEADERS" if="linux" />

	
	<haxelib name="hxcpp-debug-server" if="debug cpp" />
	
	

	<haxeflag name="--macro" value="addMetadata('@:build(funkin.macro.FlxMacro.buildFlxSprite())', 'flixel.FlxSprite')" />

    <section if="RELEASE_BUILD">
	    <haxeflag name="--macro" value="addMetadata('@:build(funkin.macro.FlxMacro.injectTimeScaleField())', 'flixel.tweens.FlxTween')" />

	    <haxeflag name="--macro" value="addMetadata('@:build(funkin.macro.FlxMacro.injectTimeScaleField())', 'flixel.util.FlxTimer')" />
    </section>

	<haxeflag name="--macro" value="include('flixel.addons.effects')" />

	<haxeflag name="--macro" value="include('funkin')" />

	
	<haxeflag name="-dce no" />

	

    
    <section if="FEATURE_DEBUG_TRACY">
        <haxedef name="HXCPP_TELEMETRY" />
        <haxedef name="HXCPP_TRACY" />
        <haxedef name="HXCPP_TRACY_MEMORY" />
        <haxedef name="HXCPP_TRACY_ON_DEMAND" />
        <haxedef name="absolute-paths" />
        
    </section>

	
	<haxedef name="CRASH_HANDLER" if="desktop" />

	
	<haxedef name="hscriptPos" if="HSCRIPT_ALLOWED" />

	
	<haxedef name="no-deprecation-warnings" />

	
	<haxedef name="message.reporting" value="pretty" />

	
	

	
	

	
	

	
	
	
	
	

	
	

	
	

	
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	
	
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	
	
	<haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_LINE" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_TRACE" if="CRASH_HANDLER" />

	

	
	<assets path="art/iconOG.png" rename="icon.png" if="linux" />
	
	<icon path="art/icon16.png" size="16" />
	<icon path="art/icon32.png" size="32" />
	<icon path="art/icon64.png" size="64" />
	<icon path="art/iconOG.png" />
<android install-location="auto" /></project>